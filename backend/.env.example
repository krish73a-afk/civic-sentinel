GEMINI_API_KEY=your_existing_gemini_key
FIREBASE_PROJECT_ID=your_firebase_project_id
GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/service-account.json

# Secure default. Use local_demo only for a demo bound to 127.0.0.1.
CIVIC_AUTH_MODE=firebase
FIREBASE_WEB_API_KEY=your_public_firebase_web_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_WEB_APP_ID=your_firebase_web_app_id
# Comma-separated UIDs copied from Firebase Authentication, never email addresses.
CIVIC_ADMIN_UIDS=
CIVIC_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Optional live mode switches for a presentation laptop only. Keep 0 when deploying.
CIVIC_LOCAL_MODE_SWITCH=0
